# Copy these keys into Render Dashboard > Environment Variables.
# Never commit real credentials to this file.
ENVIRONMENT=production
SECRET_KEY=<generate-a-new-random-secret-in-render>

# Use Render Postgres Internal Database URL and change postgres:// to postgresql+psycopg2://.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<internal-host>/<database>
CREATE_TABLES_ON_STARTUP=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=0
POSTGRES_POOL_PRE_PING=true
POSTGRES_POOL_RECYCLE=1800

# MVP mode: no Redis/Key Value required yet.
# Sessions and rate limiting use PostgreSQL; cache is disabled.
CACHE_ENABLED=false
CACHE_BACKEND=memory

SESSION_BACKEND=database
SESSION_SECURE_COOKIES=true

RATE_LIMITER_ENABLED=true
RATE_LIMITER_BACKEND=database

# Keep the default broker configuration until Taskiq workers are introduced.
# Do not enqueue background jobs in this MVP mode; there is no worker/broker yet.
TASKIQ_BROKER_TYPE=redis
TASKIQ_REDIS_HOST=localhost
TASKIQ_REDIS_PORT=6379
TASKIQ_REDIS_DB=3
TASKIQ_REDIS_PASSWORD=

# Temporary MVP setting because email delivery is not configured yet.
# Enable it after SMTP and a real frontend URL are configured.
PRODUCTION_SECURITY_VALIDATION_ENABLED=false
CSRF_ENABLED=true
FORWARDED_ALLOW_IPS=*
TRUSTED_PROXY_HOPS=1

CORS_ENABLED=true
CORS_ORIGINS=https://mova-quest-frontend.vercel.app,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Deepgram Nova-3. Add the real key in Render; never commit it or expose it to the frontend.
DEEPGRAM_ENABLED=true
# Temporary product-testing access; disable after testing to require authentication again.
DEEPGRAM_PUBLIC_ENABLED=false
DEEPGRAM_API_KEY=
DEEPGRAM_API_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es
DEEPGRAM_TIMEOUT_SECONDS=30
DEEPGRAM_MAX_AUDIO_BYTES=10485760
DEEPGRAM_MAX_KEYTERMS=100
DEEPGRAM_MAX_KEYTERM_TOKENS=500

# Maximum size of one PostgreSQL-backed video upload.
MEDIA_MAX_FILE_BYTES=524288000

# Swagger/OpenAPI is enabled in production and remains protected by superuser auth.
ENABLE_DOCS_IN_PRODUCTION=true
# Public documentation only; API endpoints remain protected by their own dependencies.
PUBLIC_DOCS_IN_PRODUCTION=true

ADMIN_ENABLED=false
EMAIL_BACKEND=console
FRONTEND_URL=https://mova-quest-frontend.vercel.app
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Public API origin, not the frontend. Google callback URI:
# https://<render-service>.onrender.com/api/v1/auth/oauth/callback/google
OAUTH_REDIRECT_BASE_URL=https://<render-service>.onrender.com
# Include every exact origin that can receive the OAuth callback through a trusted proxy.
OAUTH_ALLOWED_BASE_URLS=https://<render-service>.onrender.com,http://localhost:5173,http://localhost:8000
FRONTEND_ALLOWED_URLS=https://mova-quest-frontend.vercel.app,http://localhost:5173
