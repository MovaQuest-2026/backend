# Copy these keys into Render Dashboard > Environment Variables.
# Never commit real credentials to this file.
ENVIRONMENT=production
SECRET_KEY=<generate-a-new-random-secret-in-render>

# Use Render Postgres Internal Database URL and change postgres:// to postgresql+psycopg2://.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<internal-host>/<database>
CREATE_TABLES_ON_STARTUP=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=0
POSTGRES_POOL_PRE_PING=true
POSTGRES_POOL_RECYCLE=1800

# MVP mode: no Redis/Key Value required yet.
# Sessions and rate limiting use PostgreSQL; cache is disabled.
CACHE_ENABLED=false
CACHE_BACKEND=memory

SESSION_BACKEND=database
SESSION_SECURE_COOKIES=true

RATE_LIMITER_ENABLED=true
RATE_LIMITER_BACKEND=database

# Keep the default broker configuration until Taskiq workers are introduced.
# Do not enqueue background jobs in this MVP mode; there is no worker/broker yet.
TASKIQ_BROKER_TYPE=redis
TASKIQ_REDIS_HOST=localhost
TASKIQ_REDIS_PORT=6379
TASKIQ_REDIS_DB=3
TASKIQ_REDIS_PASSWORD=

# Temporary MVP setting because email delivery is not configured yet.
# Enable it after SMTP and a real frontend URL are configured.
PRODUCTION_SECURITY_VALIDATION_ENABLED=false
CSRF_ENABLED=true
FORWARDED_ALLOW_IPS=*
TRUSTED_PROXY_HOPS=1

CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

ADMIN_ENABLED=false
EMAIL_BACKEND=console
FRONTEND_URL=http://localhost:3000
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://<render-service>.onrender.com
